# Copy to .env and fill values for REAL inbox delivery.
# Without these, emails are saved to local outbox + Ethereal preview (not real inbox).

# Gmail example (use an App Password, not your normal password):
# 1) Enable 2-Step Verification on Google Account
# 2) Create App Password: https://myaccount.google.com/apppasswords
# 3) Paste below and restart backend

SMTP_SERVICE=gmail
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="MediShop Reports <your.email@gmail.com>"

# Or custom SMTP:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your.email@outlook.com
# SMTP_PASS=your_password
# MAIL_FROM="MediShop Reports <your.email@outlook.com>"

# Facebook Page and Instagram posting for Super Admin "Generate Ads".
# The Page must be the Mystoreshubs Page, with Instagram linked to it.
# Create a Page access token in Meta Business settings, then restart the API.
# META_PAGE_ID=
# META_PAGE_ACCESS_TOKEN=
# META_IG_USER_ID=
# PUBLIC_SITE_URL=https://www.mystoreshubs.com
